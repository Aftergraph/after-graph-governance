      "reason": "Version, directory, revision or content drift invalidates the SUT binding."
    },
    {
      "id": "LAB-013",
      "kind": "sut_normalization",
      "expected": "accept",
      "input": {
        "contract": "FihimFrontierLabsSutEvidence/v1",
        "integrity": "VERIFIED_DIGEST",
        "status": "OBSERVED",
        "promotion": "HOLD",
        "maximumTruthClaim": "OBSERVED",
        "authorityGranted": false,
        "verificationGranted": false,
        "scientificValidityGranted": false,
        "sut": {
          "sutId": "fihim-vnext:v0.31",
          "repository": "Aftergraph/fihim-vnext",
          "sourceRevision": "e209f21b9b226613a83f2ce63bb4107e60e266ab",
          "contentDigest": "9999999999999999999999999999999999999999999999999999999999999999",
          "immutableSubject": true
        }
      },
      "reason": "Valid SUT identity remains observational and non-promoting in Eval Lab."
    }
