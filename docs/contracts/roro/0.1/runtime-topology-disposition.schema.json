{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract:roro-runtime-topology-disposition/0.1",
  "title": "R.O.R.O. Runtime Topology Disposition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "roro-runtime-topology-disposition/0.1"},
    "subject": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["TRANSITIONAL_ACCEPTED", "TARGET_CONFIRMED", "REVIEW_REQUIRED"]},
    "epistemic_status": {"enum": ["VERIFIED", "OBSERVED", "INFERRED", "DECLARED", "PROPOSED", "STALE", "CONFLICTING", "UNKNOWN"]},
    "scope": {"type": "string", "minLength": 1},
    "target_architecture_claim": {"type": "boolean"},
    "authorizes_runtime_migration": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "required": ["schema_version", "subject", "disposition", "epistemic_status", "scope", "target_architecture_claim", "authorizes_runtime_migration", "reason", "evidence_refs", "constraints"]
}