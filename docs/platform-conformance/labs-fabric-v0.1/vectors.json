        "contentDigest": "9999999999999999999999999999999999999999999999999999999999999999",
        "observedAt": "2026-10-01T00:00:00.000Z",
        "immutableSubject": true,
        "authorityGranted": false,
        "maximumClaim": "OBSERVED",
        "bindingDigest": "8888888888888888888888888888888888888888888888888888888888888888"
      },
      "reason": "An immutable FIHIM vNext SUT subject may be represented observationally when version, path and exact identities agree."
    },
    {
      "id": "LAB-012",
      "kind": "sut_binding",
      "expected": "reject",
      "input": {
        "schemaVersion": "aftergraph.labs-sut-binding/v1",
        "sutId": "fihim-vnext:v0.31",
        "repository": "Aftergraph/fihim-vnext",
        "requestedVersion": "v0.31",
        "packageVersion": "0.32.0",
        "directoryName": "fihim-vnext-v0.30",
        "sourceRevision": "main",
        "contentDigest": "bad",
        "observedAt": "2026-10-01T00:00:00.000Z",
        "immutableSubject": true,
        "authorityGranted": false,
        "maximumClaim": "OBSERVED",
        "bindingDigest": "8888888888888888888888888888888888888888888888888888888888888888"
