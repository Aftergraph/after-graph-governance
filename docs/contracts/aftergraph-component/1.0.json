{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/aftergraph-component/1.0.json",
  "title": "Aftergraph Component Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "release", "platform", "compatibility", "contracts", "provenance"],
  "properties": {
    "schema": {"const": "aftergraph-component/1.0"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "product": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "component": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "lifecycle"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "lifecycle": {
          "enum": ["stable", "preview", "experimental", "research", "legacy", "deprecated", "retired", "ephemeral"]
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "release_train"],
      "properties": {
        "generation": {"const": 26},
        "release_train": {"type": "string", "pattern": "^20[0-9]{2}\\.(0[1-9]|1[0-2])$"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "profiles", "minimum", "tested_against"],
      "properties": {
        "level": {"const": "APC-1"},
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["authority", "service", "runtime", "execution", "verifier", "product", "model", "research"]}
        },
        "minimum": {"const": "APC-1"},
        "tested_against": {"const": "APC-1"}
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    }
  }
}
