    {
      "id": "LAB-010",
      "kind": "exact_head",
      "expected": "reject",
      "input": {
        "expectedRevision": "64c8767a4624852cfba049891df7be45238d22d6",
        "observedRevision": null,
        "httpStatus": 200
      },
      "reason": "A configured exact-head expectation requires an observed subject revision."
    },
    {
      "id": "LAB-011",
      "kind": "sut_binding",
      "expected": "accept",
      "input": {
        "schemaVersion": "aftergraph.labs-sut-binding/v1",
        "sutId": "fihim-vnext:v0.31",
