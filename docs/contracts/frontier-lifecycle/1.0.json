{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/frontier-lifecycle/1.0.json",
  "title": "Aftergraph Frontier Lifecycle Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "frontier-lifecycle/1.0" },
    "candidate_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "subject_class": {
      "type": "string",
      "enum": ["capability-family", "contract", "model", "skill", "routing", "workflow", "agent-architecture", "ui-pattern"]
    },
    "lifecycle": {
      "type": "string",
      "enum": ["experimental", "frontier", "candidate", "canonical", "quarantined", "deprecated", "archived"]
    },
    "canonical_owner_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "claims": { "type": "array", "items": { "type": "string" } },
    "non_claims": { "type": "array", "items": { "type": "string" } },
    "contract_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "verifier_refs": { "type": "array", "items": { "type": "string" } },
    "gate_ref": { "type": ["string","null"] },
    "registry_evidence_ref": { "type": ["string","null"] },
    "self_promoted": { "type": "boolean" },
    "carries_authority": { "type": "boolean" }
  },
  "required": [
    "schema","candidate_id","subject_class","lifecycle","canonical_owner_refs",
    "claims","non_claims","contract_refs","evidence_refs","verifier_refs",
    "self_promoted","carries_authority"
  ]
}
