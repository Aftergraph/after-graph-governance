{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/contracts/roro/0.1/consolidation-boundary-analysis.schema.json",
  "title": "R.O.R.O. Consolidation Boundary Analysis 0.1",
  "type": "object",
  "required": ["schema_version", "source_snapshot_generated_at", "policy", "strict_hypothesis"],
  "properties": {
    "schema_version": {"const": "roro-consolidation-boundary-analysis/0.1"},
    "source_snapshot_generated_at": {"type": "string", "minLength": 1},
    "policy": {"type": "object"},
    "strict_hypothesis": {"type": "object", "required": ["minimum_workspace_lower_bound", "derivation", "constraints"], "properties": {
      "minimum_workspace_lower_bound": {"type": "integer", "minimum": 2},
      "derivation": {"type": "string", "minLength": 1},
      "constraints": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["constraint", "effect"]}}
    }, "additionalProperties": false}
  },
  "additionalProperties": false
}
