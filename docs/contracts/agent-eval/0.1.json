{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/agent-eval/0.1.json",
  "title": "Aftergraph Agent Eval",
  "description": "EXPERIMENTAL agent-evaluation contract. It records one independent evaluator scoring a delegation record against explicit criteria with evidence references. The evaluator stays distinct from the executor, the verdict is advisory only — it never self-promotes, mutates governance state, or waives verification — and verification stays independent. It confers no authority and replaces no canonical source.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent-eval/0.1"},
    "eval_id": {"type": "string", "pattern": "^evl_[a-f0-9]{32}$"},
    "delegation_ref": {"type": "string", "pattern": "^del_[a-f0-9]{32}$"},
    "executor_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "evaluator_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "criteria_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "needs_review"]
    },
    "self_promoting": {"type": "boolean"},
    "mutates_governance": {"type": "boolean"},
    "waives_verification": {"type": "boolean"},
    "asserted_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "tenant_id": {"type": "string", "pattern": "^ten_[a-f0-9]{32}$"}
  },
  "required": [
    "schema",
    "eval_id",
    "delegation_ref",
    "executor_ref",
    "evaluator_ref",
    "criteria_refs",
    "evidence_refs",
    "verdict",
    "self_promoting",
    "mutates_governance",
    "waives_verification",
    "asserted_at",
    "tenant_id"
  ]
}
