{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aftergraph.dev/contracts/economic-evidence-pack/1.0.json",
  "title":"Economic EvidencePack v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","campaignId","economicTransactionId","assetId","rightId","legalBindingHash",
    "generatedAtUnix","sourceCaptures","componentDigests","evidenceChain","manifestHash",
    "immutable","containsCredentials","liveValueEnabled","maxLiveValue","final","externalEffects"
  ],
  "properties":{
    "schema":{"const":"aftergraph.economic-evidence-pack/v1"},
    "campaignId":{"type":"string","minLength":1},
    "economicTransactionId":{"type":"string","minLength":1},
    "assetId":{"type":"string","minLength":1},
    "rightId":{"type":"string","minLength":1},
    "legalBindingHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "generatedAtUnix":{"type":"integer","minimum":1},
    "sourceCaptures":{
      "type":"array",
      "minItems":3,
      "maxItems":3,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["sourceClass","sourceId","evidenceHash","generation","observedAtUnix"],
        "properties":{
          "sourceClass":{"enum":["registry","custody","representation"]},
          "sourceId":{"type":"string","minLength":1},
          "evidenceHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
          "generation":{"type":"integer","minimum":1},
          "observedAtUnix":{"type":"integer","minimum":1}
        }
      }
    },
    "componentDigests":{
      "type":"object",
      "additionalProperties":false,
      "required":["settlementCorrelation","legalReconciliation","evidenceCoherence","liveCanaryAssurance"],
      "properties":{
        "settlementCorrelation":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "legalReconciliation":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "evidenceCoherence":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "liveCanaryAssurance":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
      }
    },
    "evidenceChain":{
      "type":"array",
      "minItems":7,
      "maxItems":7,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["sequence","kind","subject","artifactHash","previousEntryHash","entryHash"],
        "properties":{
          "sequence":{"type":"integer","minimum":1},
          "kind":{"type":"string","minLength":1},
          "subject":{"type":"string","minLength":1},
          "artifactHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
          "previousEntryHash":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}]},
          "entryHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "manifestHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "immutable":{"const":true},
    "containsCredentials":{"const":false},
    "liveValueEnabled":{"const":false},
    "maxLiveValue":{"const":0},
    "final":{"const":false},
    "externalEffects":{"const":0}
  }
}
