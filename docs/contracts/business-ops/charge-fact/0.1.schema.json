{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/business-ops/charge-fact/0.1.schema.json",
  "title": "Business Ops ChargeFact 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tenant_id",
    "customer_ref",
    "work_order_ref",
    "execution_actuals_ref",
    "actuals_verification_ref",
    "actual_work_minutes",
    "policy_ref",
    "evidence_refs",
    "provenance",
    "completed_at"
  ],
  "properties": {
    "schema": {
      "const": "business-ops.charge-fact/0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer_ref": {
      "type": "string",
      "minLength": 1
    },
    "work_order_ref": {
      "type": "string",
      "minLength": 1
    },
    "execution_actuals_ref": {
      "type": "string",
      "minLength": 1
    },
    "actuals_verification_ref": {
      "type": "string",
      "minLength": 1
    },
    "actual_work_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "source_entity_id",
        "source_revision",
        "digest_sha256"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "source_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
