{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aftergraph.dev/contracts/economic-evidence-campaign/1.0.json",
  "title":"Economic Evidence Campaign v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","campaignId","expectation","snapshots","sourceSeparationDigest","packHash",
    "executionAuthority","liveValueEnabled","externalEffects","final"
  ],
  "properties":{
    "schema":{"const":"aftergraph.economic-evidence-campaign/v1"},
    "campaignId":{"type":"string","minLength":1},
    "expectation":{
      "type":"object",
      "additionalProperties":false,
      "required":["assetId","rightId","legalInstrumentHash","rightsHash"],
      "properties":{
        "assetId":{"type":"string","minLength":1},
        "rightId":{"type":"string","minLength":1},
        "legalInstrumentHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "rightsHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
      }
    },
    "snapshots":{
      "type":"array",
      "minItems":3,
      "maxItems":3,
      "items":{"$ref":"#/$defs/snapshot"}
    },
    "sourceSeparationDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "packHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "executionAuthority":{"const":false},
    "liveValueEnabled":{"const":false},
    "externalEffects":{"const":0},
    "final":{"const":false}
  },
  "$defs":{
    "snapshot":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "schema","sourceClass","sourceId","generation","observedAtUnix","recordSchema",
        "evidenceHash","recordHash","record","externalEffects","final"
      ],
      "properties":{
        "schema":{"const":"aftergraph.economic-evidence-source-snapshot/v1"},
        "sourceClass":{"enum":["registry","custody","representation"]},
        "sourceId":{"type":"string","minLength":1},
        "generation":{"type":"integer","minimum":1},
        "observedAtUnix":{"type":"integer","minimum":1},
        "recordSchema":{
          "enum":[
            "aftergraph.authoritative-asset-registry-record/v1",
            "aftergraph.custodial-right-record/v1",
            "aftergraph.ledger-asset-representation-record/v1"
          ]
        },
        "evidenceHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "recordHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "record":{"type":"object"},
        "externalEffects":{"const":0},
        "final":{"const":false}
      }
    }
  }
}
