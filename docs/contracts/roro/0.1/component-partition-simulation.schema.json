{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/contracts/roro/0.1/component-partition-simulation.schema.json",
  "title": "R.O.R.O. Component Partition Simulation 0.1",
  "type": "object",
  "required": ["schema_version", "source_snapshot_generated_at", "gate_scope", "policy", "candidates"],
  "properties": {
    "schema_version": {"const": "roro-component-partition-simulation/0.1"},
    "source_snapshot_generated_at": {"type": "string", "minLength": 1},
    "gate_scope": {"const": "SOURCE_TOPOLOGY_ONLY"},
    "policy": {"type": "object"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "target_architecture_claim", "authorizes_source_moves", "hard_blockers", "dimensions", "workspaces"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "target_architecture_claim": {"const": false},
          "authorizes_source_moves": {"const": false},
          "hard_blockers": {"type": "array"},
          "dimensions": {"type": "object"},
          "workspaces": {"type": "array", "minItems": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
