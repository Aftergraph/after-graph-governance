# Aftergraph platform secrets — fill in before docker compose up
# NEVER commit this file.

# Stable server-to-server TG -> WORKS platform bearer.
# Minimum 32 bytes. This is NOT a worker enrollment JWT.
# The exact same value must be set in works-api + Trust Gateway.
WORKS_API_TOKEN=

# Second factor for governed platform bridge calls.
# Minimum 32 bytes. The exact same value must be set in works-api + TG.
WORKS_PLATFORM_BRIDGE_SECRET=

# WORKS worker enrollment secret (empty = enrollment disabled, fail-closed)
WORKS_ENROLL_SECRET=

# TG admin/operator token for the console
TG_OPERATOR_TOKEN=
