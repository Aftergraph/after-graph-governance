{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/tenant-lifecycle/0.1.json",
  "title": "Aftergraph Tenant Lifecycle",
  "description": "EXPERIMENTAL tenant lifecycle evaluation contract. It pairs TG operational lifecycle state with an attempted action, so conformance can decide whether the action is admitted. Lifecycle state gates admission only; it confers no authority and never replaces domain owners, whose export/deletion/retention acknowledgements gate terminal completion.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "tenant-lifecycle/0.1"},
    "lifecycle_id": {"type": "string", "pattern": "^lif_[a-f0-9]{32}$"},
    "tenant_id": {"type": "string", "pattern": "^ten_[a-f0-9]{32}$"},
    "state": {
      "type": "string",
      "enum": ["active", "suspended", "exporting", "deleting", "deleted"]
    },
    "previous_state": {
      "type": ["string", "null"],
      "enum": ["active", "suspended", "exporting", "deleting", "deleted", null]
    },
    "required_owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "owner_acknowledgements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": {"type": "string", "minLength": 1, "maxLength": 160},
          "ack": {"type": "string", "enum": ["export", "deletion", "retention"]}
        },
        "required": ["owner", "ack"]
      }
    },
    "attempted_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["none", "grant", "ingestion", "execution", "complete_export", "complete_deletion"]
        },
        "at": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "required": ["kind", "at"]
    },
    "recorded_at": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "required": [
    "schema",
    "lifecycle_id",
    "tenant_id",
    "state",
    "previous_state",
    "required_owners",
    "owner_acknowledgements",
    "attempted_action",
    "recorded_at"
  ]
}
