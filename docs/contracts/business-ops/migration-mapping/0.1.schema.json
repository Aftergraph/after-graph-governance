{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/business-ops/migration-mapping/0.1.schema.json",
  "title": "Business Ops Migration Mapping 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "source_system",
    "source_entity_type",
    "source_entity_id",
    "target_entity_type",
    "target_entity_id",
    "status",
    "confidence",
    "source_snapshot",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "business-ops.migration-mapping/0.1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "source_entity_type": {
      "type": "string",
      "minLength": 1
    },
    "source_entity_id": {
      "type": "string",
      "minLength": 1
    },
    "target_entity_type": {
      "type": "string",
      "minLength": 1
    },
    "target_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "EXACT",
        "REVIEWED",
        "AMBIGUOUS",
        "REJECTED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "AMBIGUOUS",
              "REJECTED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "target_entity_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "EXACT",
              "REVIEWED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "target_entity_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
