{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/release-passport/1.0.json",
  "title": "Aftergraph Release Passport 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "platform", "conformance", "provenance"],
  "properties": {
    "schema": {"const": "release-passport/1.0"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1, "pattern": "^[^\\x00-\\x20\\x7f-\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+$"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "release_train", "compatibility"],
      "properties": {
        "generation": {"const": 26},
        "release_train": {"type": "string", "pattern": "^20[0-9]{2}\\.(0[1-9]|1[0-2])$"},
        "compatibility": {"const": "APC-1"}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "profiles", "evidence"],
      "properties": {
        "result": {"const": "PASS"},
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": ["authority", "service", "runtime", "execution", "verifier", "product", "model", "research"]
          },
          "additionalProperties": {"enum": ["PASS", "N/A"]},
          "anyOf": [
            {"required": ["authority"], "properties": {"authority": {"const": "PASS"}}},
            {"required": ["service"], "properties": {"service": {"const": "PASS"}}},
            {"required": ["runtime"], "properties": {"runtime": {"const": "PASS"}}},
            {"required": ["execution"], "properties": {"execution": {"const": "PASS"}}},
            {"required": ["verifier"], "properties": {"verifier": {"const": "PASS"}}},
            {"required": ["product"], "properties": {"product": {"const": "PASS"}}},
            {"required": ["model"], "properties": {"model": {"const": "PASS"}}},
            {"required": ["research"], "properties": {"research": {"const": "PASS"}}}
          ]
        },
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "artifact_digest", "manifest_digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
