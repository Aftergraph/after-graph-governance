{
  "$id": "contract:roro-credential-binding/0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consumer_ref": {
      "type": "string"
    },
    "credential_ref": {
      "pattern": "^credential://",
      "type": "string"
    },
    "epistemic_status": {
      "enum": [
        "VERIFIED",
        "OBSERVED",
        "INFERRED",
        "DECLARED",
        "PROPOSED",
        "STALE",
        "CONFLICTING",
        "UNKNOWN"
      ]
    },
    "permission_state": {
      "enum": [
        "RESTRICTED",
        "DRIFT",
        "UNKNOWN"
      ]
    },
    "storage_class": {
      "enum": [
        "ENV_FILE",
        "SECRET_STORE",
        "PROVIDER_BINDING",
        "UNKNOWN"
      ]
    },
    "values_collected": {
      "const": false
    }
  },
  "required": [
    "credential_ref",
    "consumer_ref",
    "storage_class",
    "permission_state",
    "values_collected",
    "epistemic_status"
  ],
  "title": "R.O.R.O. Credential Binding Metadata",
  "type": "object"
}
