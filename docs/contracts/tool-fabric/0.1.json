{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/contracts/tool-fabric/0.1.json",
  "title": "Aftergraph ToolFabric 0.1",
  "description": "Experimental cross-repository capability discovery, routing, admission and execution-binding contract. Routing and discovery never grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "status", "invariants", "owners", "schemas"],
  "properties": {
    "contract": {"const": "tool-fabric/0.1"},
    "status": {"const": "experimental"},
    "invariants": {
      "type": "array",
      "minItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration", "routing", "admission", "runtime_binding", "durable_execution", "verification"],
      "properties": {
        "registration": {"const": "Aftergraph/after-graph-governance"},
        "routing": {"const": "Aftergraph/core"},
        "admission": {"const": "Aftergraph/trust-gateway"},
        "runtime_binding": {"const": "Aftergraph/runtime"},
        "durable_execution": {"const": "Aftergraph/works-execution"},
        "verification": {"const": "Aftergraph/sentinel"}
      }
    },
    "participants": {
      "type": "array",
      "items": {"type": "string", "pattern": "^Aftergraph/[A-Za-z0-9._-]+$"},
      "uniqueItems": true
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "resolution", "receipt"],
      "properties": {
        "tool": {"const": "aftergraph.tool/v1"},
        "resolution": {"const": "aftergraph.tool-resolution/v1"},
        "receipt": {"const": "aftergraph.tool-receipt/v1"},
        "telemetry": {"const": "aftergraph.tool-observation/v1"}
      }
    }
  }
}
