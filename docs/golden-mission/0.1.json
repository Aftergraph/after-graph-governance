{
  "schema_version": "golden-mission-0.1",
  "status": "experimental",
  "purpose": "Skeleton registry for the first composed Golden Mission. Each branch names the repositories participating in that branch path and the acceptance vector IDs gating it. Exact-head SHA pins are generated by skeleton runs, never hand-authored; pins start empty. Cross-repository mission execution is a separate gate.",
  "branches": {
    "success": {
      "participating_repos": [
        "Aftergraph/studio",
        "Aftergraph/trust-gateway",
        "Aftergraph/runtime",
        "Aftergraph/works-execution"
      ],
      "required_vectors": ["GOLDEN-001"]
    },
    "refusal": {
      "participating_repos": ["Aftergraph/trust-gateway"],
      "required_vectors": ["GOLDEN-001", "GOLDEN-002"]
    },
    "revocation": {
      "participating_repos": [
        "Aftergraph/trust-gateway",
        "Aftergraph/runtime",
        "Aftergraph/works-execution"
      ],
      "required_vectors": ["GOLDEN-001", "GOLDEN-002"]
    },
    "crash-recovery": {
      "participating_repos": [
        "Aftergraph/runtime",
        "Aftergraph/works-execution"
      ],
      "required_vectors": ["GOLDEN-001"]
    },
    "verifier-failure": {
      "participating_repos": [
        "Aftergraph/works-execution",
        "Aftergraph/trust-gateway"
      ],
      "required_vectors": ["GOLDEN-001", "GOLDEN-003"]
    }
  },
  "pins": {}
}
