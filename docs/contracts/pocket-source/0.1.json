{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/pocket-source/0.1.json",
  "title": "Aftergraph Pocket Source",
  "description": "EXPERIMENTAL Pocket physical-world perception source contract. It records one tenant-scoped Pocket payload projecting to a Wie Observation with provenance, classification, and derivation lineage. Pocket output is observation only: transcript is not principal identity, speaker attribution is not principal authentication, and spoken instruction never self-executes \u2014 a consequential step still follows AIE -> Trust Gateway -> Runtime -> WORKS -> verification. It confers no authority and replaces no canonical source. Webhook deliveries are event-plane signals guarded by structural signature binding, replay protection, and idempotency dedupe; REST hydration reconciles event-plane state to canonical data, and webhooks never become reconciliation truth.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pocket-source/0.1"
    },
    "pocket_id": {
      "type": "string",
      "pattern": "^pck_[a-f0-9]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[a-f0-9]{32}$"
    },
    "credential_scope": {
      "type": "string",
      "pattern": "^ten_[a-f0-9]{32}$"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "observation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "classification": {
      "type": "string",
      "enum": [
        "authority",
        "enforcement",
        "runtime",
        "execution",
        "verification",
        "research"
      ]
    },
    "claims_principal_identity": {
      "type": "boolean"
    },
    "claims_principal_authentication": {
      "type": "boolean"
    },
    "contains_instruction": {
      "type": "boolean"
    },
    "self_executes": {
      "type": "boolean"
    },
    "claims_execution": {
      "type": "boolean"
    },
    "candidate_kind": {
      "type": "string",
      "enum": [
        "observation_update",
        "attention_candidate",
        "commitment_candidate",
        "finding"
      ]
    },
    "admitted_by_tg": {
      "type": "boolean"
    },
    "governed_path_complete": {
      "type": "boolean"
    },
    "derivations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "derivation": {
            "type": "string",
            "enum": [
              "transcript",
              "speaker_attribution",
              "summary",
              "action_extraction"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "uncertainty": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lineage_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "derivation",
          "weight",
          "uncertainty",
          "lineage_ref"
        ]
      }
    },
    "asserted_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "delivery_channel": {
      "type": "string",
      "enum": ["rest", "webhook"]
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "signature_scheme": {
      "type": "string",
      "enum": ["hmac-sha256"]
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^dlv_[a-f0-9]{32}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^idem_[a-f0-9]{32}$"
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 0
    },
    "applied_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "resurrects_superseded_content": {
      "type": "boolean"
    },
    "seen_delivery_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^dlv_[a-f0-9]{32}$"
      }
    },
    "known_idempotency_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^idem_[a-f0-9]{32}$"
      }
    },
    "materialized_observations": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": "string",
      "pattern": "^dlv_[a-f0-9]{32}$"
    },
    "lineage_preserved": {
      "type": "boolean"
    },
    "tombstone": {
      "type": "boolean"
    },
    "withdrawn_from_reads": {
      "type": "boolean"
    },
    "audit_retained": {
      "type": "boolean"
    },
    "reconciles_to_canonical": {
      "type": "boolean"
    },
    "webhook_claimed_as_truth": {
      "type": "boolean"
    },
    "consent_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "consent_revoked": {
      "type": "boolean"
    },
    "downstream_invalidated": {
      "type": "boolean"
    },
    "audit_rewritten": {
      "type": "boolean"
    },
    "source_deleted": {
      "type": "boolean"
    },
    "deletion_propagated": {
      "type": "boolean"
    },
    "projection_recomputed": {
      "type": "boolean"
    },
    "stale_served_as_current": {
      "type": "boolean"
    },
    "injection_contained": {
      "type": "boolean"
    },
    "conversation_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "attributed_conversation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "cross_conversation_lineage": {
      "type": "boolean"
    },
    "access_mode": {
      "type": "string",
      "enum": ["interactive", "canonical"]
    }
  },
  "required": [
    "schema",
    "pocket_id",
    "tenant_id",
    "credential_scope",
    "source_ref",
    "observation_ref",
    "classification",
    "claims_principal_identity",
    "claims_principal_authentication",
    "contains_instruction",
    "self_executes",
    "claims_execution",
    "candidate_kind",
    "admitted_by_tg",
    "governed_path_complete",
    "derivations",
    "asserted_at"
  ]
}
