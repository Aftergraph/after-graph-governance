{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aftergraph.dev/contracts/economic-legal-records/1.0.json",
  "title":"Economic Legal/Custody/Representation Records v1",
  "$defs":{
    "hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "status":{"enum":["ACTIVE","SUSPENDED","REVOKED","UNKNOWN"]},
    "common":{
      "type":"object",
      "required":["assetId","rightId","legalInstrumentHash","rightsHash","evidenceHash","status","externalEffects","final"],
      "properties":{
        "assetId":{"type":"string","minLength":1},
        "rightId":{"type":"string","minLength":1},
        "legalInstrumentHash":{"$ref":"#/$defs/hash"},
        "rightsHash":{"$ref":"#/$defs/hash"},
        "evidenceHash":{"$ref":"#/$defs/hash"},
        "status":{"$ref":"#/$defs/status"},
        "externalEffects":{"const":0},
        "final":{"const":false}
      }
    }
  },
  "oneOf":[
    {
      "allOf":[{"$ref":"#/$defs/common"}],
      "required":["schema","registryId","recordHash"],
      "properties":{
        "schema":{"const":"aftergraph.authoritative-asset-registry-record/v1"},
        "registryId":{"type":"string","minLength":1},
        "recordHash":{"$ref":"#/$defs/hash"}
      }
    },
    {
      "allOf":[{"$ref":"#/$defs/common"}],
      "required":["schema","custodianId","custodyRef","accountFingerprint","recordHash"],
      "properties":{
        "schema":{"const":"aftergraph.custodial-right-record/v1"},
        "custodianId":{"type":"string","minLength":1},
        "custodyRef":{"type":"string","minLength":1},
        "accountFingerprint":{"$ref":"#/$defs/hash"},
        "recordHash":{"$ref":"#/$defs/hash"}
      }
    },
    {
      "allOf":[{"$ref":"#/$defs/common"}],
      "required":["schema","network","representationId","representationHash"],
      "properties":{
        "schema":{"const":"aftergraph.ledger-asset-representation-record/v1"},
        "network":{"type":"string","minLength":1},
        "representationId":{"type":"string","minLength":1},
        "representationHash":{"$ref":"#/$defs/hash"}
      }
    }
  ]
}
