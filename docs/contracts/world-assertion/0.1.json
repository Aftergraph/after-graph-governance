{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.dev/contracts/world-assertion/0.1.json",
  "title": "Aftergraph World Assertion",
  "description": "EXPERIMENTAL World State assertion contract. It records a subject/predicate/value claim with epistemic and currentness state, provenance, timing, scope, and consent/purpose lineage. It carries no authority, grants no execution, and never replaces canonical sources: World State is a rebuildable projection, not writable truth.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "world-assertion/0.1"},
    "assertion_id": {"type": "string", "pattern": "^ast_[a-f0-9]{32}$"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 512},
    "predicate": {"type": "string", "minLength": 1, "maxLength": 160},
    "value_or_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "epistemic": {
      "type": "string",
      "enum": ["observed", "inferred", "predicted", "unknown"]
    },
    "currentness": {
      "type": "string",
      "enum": ["current", "stale", "disputed", "superseded"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "evidence_observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "asserted_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "valid_until": {"type": "string", "minLength": 1, "maxLength": 64},
    "tenant_id": {"type": "string", "pattern": "^ten_[a-f0-9]{32}$"},
    "domain": {"type": "string", "minLength": 1, "maxLength": 160},
    "classification": {"type": "string", "minLength": 1, "maxLength": 160},
    "consent_record": {"type": "string", "minLength": 1, "maxLength": 256},
    "consent_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 256},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_requirement": {
      "type": "string",
      "enum": ["none", "current_observed"]
    }
  },
  "required": [
    "schema",
    "assertion_id",
    "subject",
    "predicate",
    "value_or_ref",
    "epistemic",
    "currentness",
    "source_refs",
    "evidence_refs",
    "observed_at",
    "evidence_observed_at",
    "asserted_at",
    "valid_until",
    "tenant_id",
    "domain",
    "classification",
    "consent_record",
    "consent_version",
    "purpose",
    "evidence_requirement"
  ]
}
